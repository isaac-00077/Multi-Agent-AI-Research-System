# ==========================================
# AETHERIS RESEARCH SYSTEM - ENVIRONMENT VARIABLES
# ==========================================

# Groq API Key (required for LLM agents)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (required for real-time web search)
# Obtain from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Groq Model (Optional, defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Server Port (Render sets this dynamically; default local is 8000)
PORT=8000
